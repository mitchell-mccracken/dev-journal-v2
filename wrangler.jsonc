{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-journal",
  // The same Hono API that runs on Heroku (server/src/app.ts), plus the static
  // client build.
  "main": "./server/src/worker.ts",
  "compatibility_date": "2026-09-01",
  // The MongoDB driver needs node:net/tls, and this also puts vars and secrets
  // on process.env so config reads them the same way as on Node.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    // Vue Router uses history mode, so unknown paths must fall back to
    // index.html instead of 404ing.
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback would answer /api/* with index.html.
    "run_worker_first": ["/api/*"]
  },
  // Not secret. Matches Heroku, where CORS accepts any origin in production.
  "vars": { "NODE_ENV": "production",  "JWT_EXPIRES_IN": "7d"},
  "observability": { "enabled": true },
  // MONGODB_URI and JWT_SECRET live in the dashboard as Secrets (see
  // DEPLOYMENT.md). This stops a deploy from wiping any plain-text variables
  // set there too.
  "keep_vars": true
}
